<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xd.mapper.ChatMessageMapper">
    <resultMap id="BaseResultMap" type="com.xd.model.entity.ChatMessageDO">
        <id property="id" column="id"/>
        <result property="messageId" column="message_id"/>
        <result property="taskId" column="task_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="runId" column="run_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,
        message_id,
        task_id,
        session_id,
        run_id,
        role,
        content,
        created_at
    </sql>

    <!-- 新增聊天消息 -->
    <insert id="insertChatMessage" parameterType="com.xd.model.entity.ChatMessageDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_chat_message (
            message_id,
            session_id,
            task_id,
            run_id,
            role,
            content,
            created_at
        )
        VALUES (
            #{messageId},
            #{sessionId},
            #{taskId},
            #{runId},
            #{role},
            #{content},
            #{createdAt}
        )

    </insert>

    <select id="selectBySessionId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY created_at ASC, id ASC
    </select>

    <select id="selectByTaskIdAndRunId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_chat_message
        <where>
            <if test="taskId != null and taskId != ''">
                AND task_id = #{taskId}
            </if>
            <if test="runId != null and runId != ''">
                AND run_id = #{runId}
            </if>
        </where>
        ORDER BY created_at ASC, id ASC
    </select>

    <select id="selectByTaskIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_chat_message
        WHERE task_id IN
        <foreach collection="list" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
        ORDER BY created_at ASC
    </select>

    <select id="selectRecentBySessionId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_chat_message
        WHERE session_id IN
        <foreach collection="list" item="sessionId" open="(" separator="," close=")">
            #{sessionId}
        </foreach>
        ORDER BY created_at ASC
        limit #{round}
    </select>
</mapper>