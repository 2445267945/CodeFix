<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xd.mapper.AgentRunMapper">

    <resultMap id="BaseResultMap" type="com.xd.model.entity.AgentRunDO">
        <id property="id" column="id"/>
        <result property="runId" column="run_id"/>
        <result property="taskId" column="task_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="actionId" column="action_id"/>
        <result property="attempt" column="attempt"/>
        <result property="status" column="status"/>
        <result property="permissionProfile" column="permission_profile"/>
        <result property="startedAt" column="started_at"/>
        <result property="endedAt" column="ended_at"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,
        run_id,
        task_id,
        session_id,
        action_id,
        attempt,
        status,
        permission_profile,
        started_at,
        ended_at,
        error_message,
        created_at
    </sql>

    <insert id="insertAgentRun" parameterType="com.xd.model.entity.AgentRunDO">
        INSERT INTO agent_run (
            run_id,
            task_id,
            session_id,
            attempt,
            status,
            permission_profile,
            started_at,
            ended_at,
            error_message,
            created_at
        )
        VALUES (
            #{runId},
            #{taskId},
            #{sessionId},
            #{attempt},
            #{status},
            #{permissionProfile},
            #{startedAt},
            #{endedAt},
            #{errorMessage},
            #{createdAt}
        )
    </insert>

    <select id="selectMaxAttemptByTaskId" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT COALESCE(MAX(attempt), 0)
        FROM agent_run
        WHERE task_id = #{taskId}
    </select>

    <select id="selectByTaskId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_run
        WHERE task_id = #{taskId}
        ORDER BY attempt DESC, id DESC
    </select>

    <update id="updateRun">
        UPDATE agent_run
        <set>
            <if test="actionId != null">
                action_id = #{actionId},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="startedAt != null">
                started_at = #{startedAt},
            </if>
            <if test="endedAt != null">
                ended_at = #{endedAt},
            </if>
            <if test="errorMessage != null">
                error_message = #{errorMessage},
            </if>
        </set>
        WHERE run_id = #{runId}
    </update>

    <select id="selectByTaskIdAndRunId" resultMap="BaseResultMap">
        SELECT
            id,
            run_id,
            task_id,
            session_id,
            attempt,
            status,
            started_at,
            ended_at,
            error_message,
            created_at
        FROM agent_run
        WHERE task_id = #{taskId}
          AND run_id = #{runId}
            LIMIT 1
    </select>
</mapper>