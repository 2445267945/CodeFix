<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xd.mapper.AgentTaskMapper">
    <resultMap id="BaseResultMap" type="com.xd.model.entity.AgentTaskDO">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="runId" column="run_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="version" column="version"/>
        <result property="question" column="question"/>
        <result property="lastHeartbeatAt" column="last_heartbeat_at"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,
        task_id,
        session_id,
        run_id,
        version,
        question,
        status,
        last_heartbeat_at,
        created_at,
        updated_at
    </sql>


    <insert id="insertAgentTask" parameterType="com.xd.model.entity.AgentTaskDO">
        INSERT INTO agent_task (
            task_id,
            session_id,
            run_id,
            version,
            question,
            status,
            created_at,
            updated_at
        )
        VALUES (
             #{taskId},
             #{sessionId},
             #{runId},
             #{version},
             #{question},
             #{status},
             #{createdAt},
             #{updatedAt}
               )
    </insert>

    <update id="updateTask">
        UPDATE agent_task
        <set>
            <if test="runId != null">
                run_id = #{runId},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="question != null">
                question = #{question},
            </if>
            <if test="updatedAt != null">
                updated_at = #{updatedAt},
            </if>
        </set>
        WHERE task_id = #{taskId}
    </update>

    <select id="selectByTaskId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_task
        WHERE task_id = #{taskId}
    </select>

    <select id="selectTaskList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_task
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="selectBySessionId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_task
        WHERE session_id = #{sessionId}
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="selectHeartbeatTasks" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_task
        WHERE status IN (3, 4)
    </select>

    <update id="updateStatusByHeartbeatTimeout">
        UPDATE agent_task
        SET
            status = #{nextStatus},
            updated_at = #{updatedAt}
        WHERE task_id = #{taskId}
          AND run_id = #{runId}
          AND status = #{currentStatus}
          AND last_heartbeat_at = #{lastHeartbeatAt}
    </update>

    <update id="updateHeartbeat">
        UPDATE agent_task
        SET last_heartbeat_at = #{lastHeartbeatAt}
        WHERE task_id = #{taskId}
          AND run_id = #{runId}
    </update>
</mapper>