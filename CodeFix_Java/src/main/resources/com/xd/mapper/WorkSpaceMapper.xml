<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xd.mapper.WorkSpaceMapper">

    <resultMap id="BaseResultMap"
               type="com.xd.model.entity.WorkspaceDO">

        <id property="id" column="id"/>

        <result property="workspaceId"
                column="workspace_id"/>

        <result property="name"
                column="name"/>

        <result property="rootPath"
                column="root_path"/>

        <result property="status"
                column="status"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

    </resultMap>

    <sql id="Base_Column_List">
        id,
        workspace_id,
        name,
        root_path,
        status,
        created_at,
        updated_at
    </sql>

    <insert id="insertWorkspace" parameterType="com.xd.model.entity.WorkspaceDO" useGeneratedKeys="true" keyProperty="id">

        INSERT INTO agent_workspace (
        workspace_id,
        name,
        root_path,
        status,
        created_at,
        updated_at
        )
        VALUES (
        #{workspaceId},
        #{name},
        #{rootPath},
        #{status},
        #{createdAt},
        #{updatedAt}
        )

    </insert>

    <select id="selectByWorkspaceId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_workspace
        WHERE workspace_id = #{workspaceId}
    </select>

    <update id="updateWorkspace" parameterType="com.xd.model.entity.WorkspaceDO">
        UPDATE agent_workspace
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="rootPath != null">
                root_path = #{rootPath},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updatedAt != null">
                updated_at = #{updatedAt},
            </if>
        </set>
        WHERE workspace_id = #{workspaceId}
    </update>

    <resultMap id="WorkspaceSessionRowMap"
               type="com.xd.model.dto.WorkspaceSessionRowDTO">
        <result property="workspaceId" column="ws_workspace_id"/>
        <result property="workspaceName" column="ws_name"/>
        <result property="sessionId" column="se_session_id"/>
        <result property="title" column="se_title"/>
        <result property="sessionCreatedAt" column="se_created_at"/>
        <result property="sessionUpdatedAt" column="se_updated_at"/>
    </resultMap>

    <select id="selectWorkspaceSessions" resultMap="WorkspaceSessionRowMap">
        SELECT
        w.workspace_id AS ws_workspace_id,
        w.name         AS ws_name,
        s.session_id   AS se_session_id,
        s.title        AS se_title,
        s.created_at   AS se_created_at,
        s.updated_at   AS se_updated_at
        FROM agent_workspace w
        LEFT JOIN agent_session s ON s.workspace_id = w.workspace_id
        ORDER BY w.updated_at DESC, s.created_at DESC
    </select>

    <select id="selectAllWorkspaces" resultType="com.xd.model.entity.WorkspaceDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_workspace
        ORDER BY updated_at DESC
    </select>

    <select id="selectWorkspaceByRootPath" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_workspace
        WHERE root_path = #{rootPath}
        LIMIT 1
    </select>
</mapper>