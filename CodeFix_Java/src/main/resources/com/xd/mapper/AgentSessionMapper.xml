<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xd.mapper.AgentSessionMapper">
    <resultMap id="BaseResultMap" type="com.xd.model.entity.AgentSessionDO">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="workspaceId" column="workspace_id"/>
        <result property="title" column="title"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <sql id="Base_Column_List">
        id,
        session_id,
        workspace_id,
        title,
        created_at,
        updated_at
    </sql>

    <insert id="insertSession" parameterType="com.xd.model.entity.AgentSessionDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_session (
            session_id,
            workspace_id,
            title,
            created_at,
            updated_at
        )
        VALUES (
            #{sessionId},
            #{workspaceId},
            #{title},
            #{createdAt},
            #{updatedAt}
       )

    </insert>

    <select id="selectBySessionId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_session
        WHERE session_id = #{sessionId}
    </select>

    <select id="selectSessions" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_session
        ORDER BY created_at DESC
    </select>

    <select id="selectByWorkspaceId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM agent_session
        WHERE workspace_id = #{workspaceId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByTaskId" resultType="com.xd.model.entity.ChatMessageDO">
        SELECT
            id,
            message_id,
            session_id,
            title,
            task_id,
            run_id,
            role,
            content,
            created_at
        FROM chat_message
        WHERE task_id = #{taskId}
        ORDER BY created_at ASC
    </select>

    <update id="updateSession" parameterType="com.xd.model.entity.AgentSessionDO">
        UPDATE agent_session
        <set>
            <if test="workspaceId != null">
                workspace_id = #{workspaceId},
            </if>
            <if test="updatedAt != null">
                updated_at = #{updatedAt},
            </if>
        </set>
        WHERE session_id = #{sessionId}
    </update>

</mapper>